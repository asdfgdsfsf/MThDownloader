{
  "manifest_version": 3,
  "name": "MThDownloader 下载桥接",
  "version": "1.0.0",
  "description": "拦截浏览器下载，并将下载地址交给本机 MThDownloader.exe 进行多线程下载（Chrome / Edge 通用）。",
  "minimum_chrome_version": "109",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "storage",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "MThDownloader 下载桥接",
    "default_popup": "options.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
